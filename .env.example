# Copy to .env and fill in. Sourced by the Makefile.

# Container registry (Gitea container registry, no trailing slash).
# Image tags become: ${REGISTRY}/<tool>:${TAG}
REGISTRY=git.sable-chinstrap.ts.net/rakshak
TAG=latest

# Optional: credentials for `make login`.
# Use a Gitea access token with package:write scope.
GITEA_USER=
GITEA_TOKEN=
